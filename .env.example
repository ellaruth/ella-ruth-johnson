# ====================================================================
# Safe Haven Outreach Ministries & Pastor Ella Ruth Johnson
# Environment Configuration Template (.env.example)
# Copy this file to .env: cp .env.example .env
# ====================================================================

# Port for server (default: 3000)
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=development

# --------------------------------------------------------------------
# ADMIN PORTAL PASSCODE
# Protects staff admin routes (/api/admin/*, creating events, sermons, announcements).
# Change this to your preferred secure passphrase.
# --------------------------------------------------------------------
ADMIN_PASSCODE="SafeHaven2026!"

# --------------------------------------------------------------------
# TURSO CLOUD SQLITE (Optional for local dev, used on Vercel production)
# Get these from https://turso.tech dashboard after creating a database.
# --------------------------------------------------------------------
# TURSO_DATABASE_URL="libsql://ellaruth-db-yourusername.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token-here"

# --------------------------------------------------------------------
# AI & EXTERNAL SERVICES (Optional)
# --------------------------------------------------------------------
# GEMINI_API_KEY="your-gemini-api-key-here"
